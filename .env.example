# Copy to .env and fill in. .env is gitignored.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required: HolmesGPT LLM backend (OpenRouter)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# Model to use, in LiteLLM OpenRouter form: openrouter/<vendor>/<model>
HOLMES_MODEL=openrouter/anthropic/claude-sonnet-4.5

# ---------------------------------------------------------------------------
# Optional: GitHub PAT for HolmesGPT's GitHub MCP server (namespace
# holmesgpt, secret github-mcp-token). Needs access to the repos Holmes
# should investigate: classic `repo`, or a fine-grained token granted those
# repos with Contents/Metadata/Pull requests/Actions: read and Issues:
# read+write so Holmes can open issues. A fine-grained token that is not
# granted the repo gets 404s, and Holmes reports the repo as missing.
# If unset, the GitHub toolset is skipped.
# ---------------------------------------------------------------------------
GITHUB_PAT=

# Optional: token for pulling a PRIVATE ghcr.io frontend image (namespace
# microservices-demo, secret ghcr-pull). ghcr.io only accepts CLASSIC PATs
# with the `read:packages` scope; fine-grained tokens are rejected whatever
# their permissions, so a fine-grained GITHUB_PAT cannot be reused here.
# Defaults to GITHUB_PAT (right when that is a classic token with both `repo`
# and `read:packages`). Leave both empty if the package is public.
# GHCR_PAT=

# Username for the ghcr.io pull secret. Defaults to the package owner parsed
# from FRONTEND_IMAGE_REPO (ghcr.io/<owner>/...), which is normally right.
# GITHUB_USER=

# ---------------------------------------------------------------------------
# Frontend image. Defaults to the upstream Online Boutique frontend.
# Point these at your own build to swap ONLY the frontend service. A private
# ghcr.io package works as long as GHCR_PAT (above) can read it; preflight
# and step 60 check the pull from this machine before touching the cluster.
#   FRONTEND_IMAGE_REPO=ghcr.io/ludvigsegerholmop/frontend
#   FRONTEND_IMAGE_TAG=sha-8cfa654
# Roll a different tag into a running cluster without editing this file:
#   ./deploy-frontend.sh sha-3a75a95
# ---------------------------------------------------------------------------
FRONTEND_IMAGE_REPO=us-central1-docker.pkg.dev/google-samples/microservices-demo/frontend
FRONTEND_IMAGE_TAG=v0.10.5

# ---------------------------------------------------------------------------
# Load generator: simulated users and spawn rate (users/second).
# The load profile itself is manifests/online-boutique/locustfile.py.
# Both can be overridden per run: LOADGEN_USERS=40 ./setup.sh --only 60
# ---------------------------------------------------------------------------
LOADGEN_USERS=20
LOADGEN_RATE=2

# ---------------------------------------------------------------------------
# Cluster sizing. Defaults suit a 16GB+ machine.
# Stop the podman machine first if you are short on RAM: podman machine stop
# ---------------------------------------------------------------------------
MINIKUBE_PROFILE=holmesgpt-demo
MINIKUBE_DRIVER=vfkit
MINIKUBE_CPUS=6
MINIKUBE_MEMORY=12288
MINIKUBE_DISK=40g

# Grafana admin password (demo only)
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Ingress domain. The UIs are served as shop.<domain>, grafana.<domain> and
# chat.<domain>. Leave empty for <minikube ip>.nip.io, a public wildcard DNS
# that resolves to the node with nothing to configure locally. If your DNS
# resolver blocks nip.io, set a domain here and add the three hostnames to
# /etc/hosts pointing at `minikube -p holmesgpt-demo ip`.
# ---------------------------------------------------------------------------
INGRESS_DOMAIN=
